NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Razorpay — get from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here
# Webhook signing secret (Dashboard → Settings → Webhooks).
# Subscribe to events: payment.captured, order.paid
# Endpoint URL: https://<your-domain>/api/razorpay/webhook
# REQUIRED: without this, orders where the customer closes the tab mid-payment
# stay payment_status="pending" even though the money is captured.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ──────────────────────────────────────────────
# Admin panel auth — single shared password
# ──────────────────────────────────────────────
# Password that unlocks /admin/*. Set to something strong (12+ chars).
ADMIN_PASSWORD=
# HMAC key for the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this value signs out all current admin sessions.
ADMIN_SESSION_SECRET=

# ──────────────────────────────────────────────
# WhatsApp Cloud API (Meta — graph.facebook.com)
# ──────────────────────────────────────────────
# Setup steps (do these in WhatsApp Manager + Meta App Dashboard):
#   1. Create a Meta Business + WhatsApp Business Account (WABA)
#   2. Add a phone number to the WABA (dedicated number, not your personal one)
#   3. In Meta App Dashboard → WhatsApp → API Setup: copy Phone Number ID
#   4. Generate a permanent System User access token, paste into WHATSAPP_ACCESS_TOKEN
#   5. Meta App Dashboard → Settings → Basic → copy App Secret → WHATSAPP_APP_SECRET
#   6. Pick any random string for WHATSAPP_VERIFY_TOKEN
#   7. Meta App Dashboard → WhatsApp → Configuration → Webhook
#         Callback URL: https://<your-domain>/api/whatsapp/webhook
#         Verify token: same value as WHATSAPP_VERIFY_TOKEN
#         Subscribe to: messages
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ADMIN_NUMBER=               # 10-digit owner mobile for handoff pings
# WHATSAPP_API_VERSION=v21.0         # optional

# Delhivery (domestic India shipping)
DELHIVERY_TOKEN=your_delhivery_token
DELHIVERY_PICKUP_LOCATION="World of Mysore Pak"
DELHIVERY_PICKUP_PINCODE=570011

# DHL India SOAP / WCF service (international shipping)
# Endpoint published at https://dhlindiaplugin.com/DHLWCFService_V6/DHLService.svc?wsdl
DHL_API_BASE_URL=https://dhlindiaplugin.com/DHLWCFService_V6/DHLService.svc
DHL_SITE_ID=your_dhl_site_id
DHL_PASSWORD=your_dhl_password
# REQUIRED for shipment creation (PostShipment_V6). Rate quotes work without it.
DHL_ACCOUNT_NUMBER=your_dhl_shipper_account
DHL_PICKUP_NAME="World of Mysore Pak"
DHL_PICKUP_PHONE=+910000000000
DHL_PICKUP_EMAIL=support@worldofmysorepak.com
DHL_PICKUP_ADDRESS_LINE1=
DHL_PICKUP_CITY=Mysuru
DHL_PICKUP_POSTAL_CODE=570011
DHL_PICKUP_STATE=KA
DHL_PICKUP_COUNTRY=IN

# India compliance fields — REQUIRED for shipment creation (PostShipment_CSBV).
# Rate quotes (PostQuote_RAS) work without these; only shipment-create needs them.
DHL_IEC_NO=                    # Import Export Code from your DGFT certificate
DHL_GSTIN=                     # Your business GSTIN, e.g. 29AAKFI8322D1ZB
DHL_BANK_AD_CODE=              # Authorised Dealer Code from your bank (14-digit)
DHL_PICKUP_STATE_CODE=29       # GST state code; 29 = Karnataka
DHL_PICKUP_STATE_NAME=Karnataka

# GST treatment for exports — defaults assume LUT (zero-rated, most common for SMB)
DHL_IS_USING_IGST=NO           # YES if paying IGST and claiming refund; NO if exporting under LUT
DHL_USING_BOND_OR_UT=YES       # YES if exporting under Letter of Undertaking
DHL_IGST_PERCENTAGE=0          # 0 for LUT exports; 5 or 18 if IsUsingIGST=YES

# Optional FX fallback used when api.exchangerate.host is unreachable
DHL_FX_USD_INR_FALLBACK=85

# ──────────────────────────────────────────────
# DTDC — domestic India courier (customer integration API)
# ──────────────────────────────────────────────
# Staging hosts (booking/label/cancel + tracking are on different stacks).
# For live, swap to: https://pxapi.dtdc.in/api/customer/integration
#              and:  https://blktracksvc.dtdc.com/dtdc-api
DTDC_API_BASE_URL=https://alphademodashboardapi.shipsy.io/api/customer/integration
DTDC_TRACKING_BASE_URL=https://dtdcstagingapi.dtdc.com/dtdc-tracking-api/dtdc-api
DTDC_API_KEY=                  # softdata/label/cancel auth (api-key header)
DTDC_X_ACCESS_TOKEN=           # tracking auth (x-access-token header)
DTDC_CUSTOMER_CODE=            # your DTDC customer/account code
DTDC_SERVICE_TYPE_ID=GROUND EXPRESS
DTDC_COMMODITY_ID=Other        # numeric string per DTDC commodity master, or "Other"
DTDC_BASE_RATE_INR=80
DTDC_PER_KG_INR=40
DTDC_ETD_DAYS=3-5

# DTDC pickup (origin warehouse) — required for booking.
# Phone MUST be a 10-digit Indian mobile (no +91, no spaces).
DTDC_PICKUP_NAME=World of Mysore Pak
DTDC_PICKUP_PHONE=               # 10-digit mobile
DTDC_PICKUP_ADDRESS_LINE1=
DTDC_PICKUP_ADDRESS_LINE2=
DTDC_PICKUP_PINCODE=570011
DTDC_PICKUP_CITY=Mysuru
DTDC_PICKUP_STATE=Karnataka
